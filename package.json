{
  "name": "horizonte-btc",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/generar-mapa.ts && vite build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p .",
    "db:local": "wrangler d1 migrations apply escenarios-btc --local",
    "db:remote": "wrangler d1 migrations apply escenarios-btc --remote",
    "deploy": "npm run build && wrangler deploy",
    "calibrar": "tsx scripts/calibrar.ts",
    "calibrar:backtest": "tsx scripts/calibrar.ts --backtest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.155.0"
  },
  "type": "module",
  "private": true
}